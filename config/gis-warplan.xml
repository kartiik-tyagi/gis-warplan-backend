<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="error">
    <Properties>
        <Property name="APP_NAME">gis-warplan</Property>
        <Property name="LOG_BASE">log</Property>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5p %c.%M:%L [%X{requestId}] - %m%n</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>
        <RollingFile name="LibLog"
                     fileName="${LOG_BASE}/${APP_NAME}/lib.log"
                     filePattern="${LOG_BASE}/${APP_NAME}/lib.%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>
        <RollingFile name="AppLog"
                     fileName="${LOG_BASE}/${APP_NAME}/app.log"
                     filePattern="${LOG_BASE}/${APP_NAME}/app.%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="com.gis.warplan" level="info" additivity="false">
            <AppenderRef ref="AppLog"/>
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="error">
            <AppenderRef ref="LibLog"/>
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
