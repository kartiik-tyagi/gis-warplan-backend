      "defaultOpacity": 1.0,
      "attribution": "Natural Earth"
    },
    {
      "code": "disputed",
      "label": "Disputed areas",
      "groupName": "Reference",
      "wmsLayers": "ne:disputed_areas",
      "format": "image/png",
      "transparent": true,
